# Copie para .env e preencha. O arquivo .env NUNCA deve ir para o Git (já está no .gitignore).

# Onde ficam banco, workspace e backups
BYTE_DATA_DIR=/data

# Servidor Ollama. No docker compose é o serviço "ollama"; fora do Docker, deixe vazio para usar 127.0.0.1:11434
OLLAMA_URL=http://ollama:11434

# Modelo inicial (qualquer tag válida do Ollama; é baixado se não existir)
BYTE_MODEL=qwen2.5:3b

# Painel web. Token fixo de 24+ caracteres [A-Za-z0-9_-]; gere com:  python -c "import secrets; print(secrets.token_urlsafe(32))"
BYTE_HOST=0.0.0.0
BYTE_PORT=8765
BYTE_UI_TOKEN=

# Telegram: token do @BotFather e o(s) seu(s) chat_id (separados por vírgula)
BYTE_TELEGRAM_TOKEN=
BYTE_TELEGRAM_CHAT_IDS=

# Chaves opcionais de nuvem (usadas pelo roteador quando configuradas)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Fuso horário usado pelos lembretes quando roda em Docker (fora do Docker vale o relógio do sistema)
# TZ=America/Sao_Paulo

# ---------------------------------------------------------------------------
# LIVE: Twitch + VTube Studio + voz (opcional; veja docs/live-twitch-vtube-studio.md)
# ---------------------------------------------------------------------------
# Canal onde a Byte conversa e a conta que ela usa para escrever (pode ser a sua própria conta)
# BYTE_TWITCH_CHANNEL=seu_canal
# BYTE_TWITCH_NICK=conta_do_bot
# Token de acesso de usuário com os escopos chat:read e chat:edit
# BYTE_TWITCH_TOKEN=
# Renovação automática (o token de acesso expira em poucas horas)
# BYTE_TWITCH_CLIENT_ID=
# BYTE_TWITCH_CLIENT_SECRET=
# BYTE_TWITCH_REFRESH_TOKEN=

# Quando responder: mention (só quando citam "Byte" ou @conta) | command (só com !byte) | all (toda mensagem)
# BYTE_STREAM_MODE=mention
# BYTE_STREAM_NAME=Byte
# BYTE_STREAM_TRIGGER=!byte
# Segundos de silêncio no chat até ela puxar assunto sozinha (0 = nunca)
# BYTE_STREAM_IDLE_S=0
# BYTE_STREAM_REPLY_IN_CHAT=1
# BYTE_STREAM_MODEL=qwen2.5:7b
# BYTE_STREAM_PERSONA_FILE=/caminho/persona.txt
# BYTE_STREAM_BLOCKLIST_FILE=/caminho/termos_bloqueados.txt
# BYTE_STREAM_IGNORE_USERS=outro_bot,mais_um

# VTube Studio (ative "Start API (allow plugins)" nas configurações dele)
# BYTE_VTS_URL=ws://127.0.0.1:8001
# Emoção -> nome do hotkey criado no VTube Studio
# BYTE_STREAM_EMOTIONS={"feliz": "Happy", "triste": "Sad", "brava": "Angry", "surpresa": "Surprised", "neutra": "Neutral"}
# BYTE_VTS_MOUTH_PARAM=MouthOpen

# Voz: comando de TTS que grava um WAV em {out} (o texto vai por stdin, ou use {text})
# BYTE_TTS_COMMAND=piper --model /caminho/pt_BR-faber-medium.onnx --output_file {out}
# Player de áudio (detecta pw-play, paplay, aplay ou ffplay; "none" = só anima a boca)
# BYTE_AUDIO_PLAYER=pw-play {file}

# ---------------------------------------------------------------------------
# E-mail: uma senha de app por conta (ou nomeie o segredo na aba E-mail)
# BYTE_EMAIL_APP_PASSWORD_GMAIL=
# BYTE_EMAIL_APP_PASSWORD_OUTLOOK=

# Internet (a Wikipédia funciona sem chave; configure um buscador para a web em geral)
# BYTE_SEARXNG_URL=https://sua-instancia-searxng
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# BYTE_WEB=0   desliga o acesso à internet

# ---------------------------------------------------------------------------
# Integrações (docs/integracoes.md). Leitura automática; escrita só com aprovação.
# ASANA_TOKEN=
# ASANA_WORKSPACE=
# NOTION_TOKEN=
# NOTION_PARENT_PAGE=
# TEAMS_WEBHOOK_URL=
# Push no celular/relógio pelo app ntfy (tópico longo e aleatório)
# BYTE_NTFY_TOPIC=
# Menu de agentes no painel, SOMENTE para testes
# BYTE_AGENT_MENU=1
